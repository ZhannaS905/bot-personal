# Только отдельный тестовый бот и тестовый чат до отдельного разрешения на выпуск.
BOT_TOKEN=
ADMIN_IDS=
CHAT_IDS=
WEBHOOK_SECRET=
STATE_DIR=./data
PORT=8080
# При необходимости: путь к проверенному дополнительному CA, без отключения TLS.
# NODE_EXTRA_CA_CERTS=/absolute/path/to/trusted-ca.pem

# === Настройки для Telegram (необязательно, мультиплатформенный режим) ===
# Токен бота от @BotFather:
TELEGRAM_BOT_TOKEN=
# ID чата/группы в Telegram (число, например -100xxxxxxxxxx). 
# Если не знаете ID, оставьте пустым, запустите бота и отправьте любое сообщение в группу — бот напишет ID в логах.
TELEGRAM_CHAT_ID=
# ID администраторов в Telegram через запятую (кому разрешена команда /опрос):
TELEGRAM_ADMIN_IDS=
